require('dotenv').config();
const express = require('express');
const helmet = require('helmet');
const rateLimit = require('express-rate-limit');
const crypto = require('crypto');
const app = express();
app.use(helmet());
app.use(express.json());

// Rate limiter (example)
const limiter = rateLimit({
  windowMs: 15 * 60 * 1000, // 15 minutes
  max: 100, // adjust lower for sensitive endpoints
  standardHeaders: true,
  legacyHeaders: false,
});
app.use(limiter);

// Use env var for key in this example — in production use KMS or Vault
const ENCRYPTION_KEY = process.env.ENCRYPTION_KEY; // 32 bytes base64
const IV_LENGTH = 12; // for AES-GCM

function encryptAccountNumber(plain) {
  const iv = crypto.randomBytes(IV_LENGTH);
  const cipher = crypto.createCipheriv('aes-256-gcm', Buffer.from(ENCRYPTION_KEY, 'base64'), iv, { authTagLength: 16 });
  let encrypted = cipher.update(plain, 'utf8');
  encrypted = Buffer.concat([encrypted, cipher.final()]);
  const tag = cipher.getAuthTag();
  // store iv + tag + encrypted as base64
  return Buffer.concat([iv, tag, encrypted]).toString('base64');
}

function decryptAccountNumber(ciphertextB64) {
  const buf = Buffer.from(ciphertextB64, 'base64');
  const iv = buf.slice(0, IV_LENGTH);
  const tag = buf.slice(IV_LENGTH, IV_LENGTH + 16);
  const encrypted = buf.slice(IV_LENGTH + 16);
  const decipher = crypto.createDecipheriv('aes-256-gcm', Buffer.from(ENCRYPTION_KEY, 'base64'), iv, { authTagLength: 16 });
  decipher.setAuthTag(tag);
  let dec = decipher.update(encrypted, undefined, 'utf8');
  dec += decipher.final('utf8');
  return dec;
}

function maskAccountNumber(accountNumber) {
  // show only last 4 digits, example: **** **** 1234
  const last4 = accountNumber.slice(-4);
  return '**** **** ' + last4;
}

